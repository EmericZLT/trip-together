# Copy to .local/openpanel.env. Never commit real secrets.
OPENPANEL_ORIGIN=https://api.openpanel.dev
OPENPANEL_CLIENT_ID=
OPENPANEL_CLIENT_SECRET=
ANALYTICS_HOSTNAME=example.com
# Independent random secrets, at least 32 characters. Keep stable after enabling.
ANALYTICS_HASH_KEY=
ANALYTICS_READ_TOKEN=
