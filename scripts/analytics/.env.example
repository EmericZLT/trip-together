# Copy to .local/umami.env. Never commit real secrets.
# Self-hosted: https://analytics.example.com/api
# Cloud: confirm account API base; commonly https://api.umami.is/v1
UMAMI_API_ORIGIN=https://analytics.example.com/api
UMAMI_API_TOKEN=
UMAMI_WEBSITE_ID=
ANALYTICS_HOSTNAME=trip.example.com
# Optional, after deploying the protected summary endpoint:
ANALYTICS_PRODUCT_ORIGIN=https://trip.example.com
ANALYTICS_READ_TOKEN=
